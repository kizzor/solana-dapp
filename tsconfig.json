{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  // `scripts/` and `test/` run under Hardhat, whose viem client types only exist
  // inside its own program (contract.read / contract.write). They are exercised by
  // `hardhat run` / `hardhat test`, not by the app's typecheck.
  "exclude": ["node_modules", "test", "scripts", ".tmp-explore", "artifacts", "cache"]
}
